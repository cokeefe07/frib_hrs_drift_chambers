! field_cage.sif
Header
  Mesh DB "." "field_cage"
End

Simulation
  Coordinate System = Cartesian
  Simulation Type = Steady State
  Steady State Max Iterations = 1
  Output File = "field_cage.result"
End

Constants
  Permittivity Of Vacuum = 8.8542e-12
End

Body 1
  Target Bodies(1) = 1
  Equation = 1
  Material = 1
End

Material 1
  Relative Permittivity = 1.0
End

Equation 1
  Active Solvers(1) = 1
  Calculate Electric Energy = True
End

Solver 1
  Equation = Stat Elec Solver
  Variable = Potential
  Variable DOFs = 1
  Procedure = "StatElecSolve" "StatElecSolver"
  Calculate Electric Field = False
  Calculate Electric Flux = False
  Linear System Solver = Direct
  Linear System Direct Method = UMFPACK
End

! --- OUTER GAS BOX (Grounded Vessel Walls) ---
Boundary Condition 1
  Target Boundaries(1) = 1
End

! --- BOTTOM FACE (M-THGEM) : matched to strip_cage for identical drift field ---
Boundary Condition 2
  Target Boundaries(1) = 2
  Potential = 38.3942
End

! --- TOP FACE (Cathode) : matched to strip_cage for identical drift field ---
Boundary Condition 3
  Target Boundaries(1) = 3
  Potential = -1038.3942
End

